rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------------
    // Primitives & Identity Helpers
    // ------------------------------------------------------------------------
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isOwner(uid) { 
      return isSignedIn() && request.auth.uid == uid; 
    }
    
    function hasUserRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == role.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() in ["aikennavas@gmail.com", "vantoniomolina@gmail.com", "vinumsanguinisetlacrimarum3@gmail.com", "admin@cantv.com.ve", "asistente@cantv.com.ve", "aiknav@cantv.com.ve"]) ||
        hasUserRole('admin')
      );
    }
    
    function isManager() {
      return isAdmin() || hasUserRole('supervisor');
    }
    
    function isManagerEmail(email) {
      return email.lower() in ["aikennavas@gmail.com", "vantoniomolina@gmail.com", "vinumsanguinisetlacrimarum3@gmail.com", "admin@cantv.com.ve", "asistente@cantv.com.ve", "aiknav@cantv.com.ve"] ||
             email.lower().matches('.*@cantv\\.com\\.ve$') || 
             email.lower().matches('.*@cantv\\.net$');
    }
    
    function isAdminEmail(email) {
      return email.lower() in ["aikennavas@gmail.com", "vantoniomolina@gmail.com", "vinumsanguinisetlacrimarum3@gmail.com", "admin@cantv.com.ve", "asistente@cantv.com.ve", "aiknav@cantv.com.ve"];
    }
    
    function isAllowedRoleForUser(email, role) {
      return role == 'tecnico' || role == 'unauthorized' || role == 'user' ||
             (role == 'supervisor' && (email.lower().matches('.*@cantv\\.com\\.ve$') || email.lower().matches('.*@cantv\\.net$') || email.lower() in ["aikennavas@gmail.com", "vantoniomolina@gmail.com", "vinumsanguinisetlacrimarum3@gmail.com", "admin@cantv.com.ve", "asistente@cantv.com.ve", "aiknav@cantv.com.ve"])) ||
             (role == 'admin' && email.lower() in ["aikennavas@gmail.com", "vantoniomolina@gmail.com", "vinumsanguinisetlacrimarum3@gmail.com", "admin@cantv.com.ve", "asistente@cantv.com.ve", "aiknav@cantv.com.ve"]);
    }
    
    // ------------------------------------------------------------------------
    // Global Safety Net
    // ------------------------------------------------------------------------
    match /{document=**} { 
      allow read, write: if false; 
    }

    // ------------------------------------------------------------------------
    // Users Collection (PII)
    // ------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.size() >= 5 && data.size() <= 20 &&
             data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'supervisor', 'tecnico', 'unauthorized', 'user'] &&
             (!('allowPasswordChange' in data) || data.allowPasswordChange is bool) &&
             (!('department' in data) || data.department is string || data.department == null) &&
             (!('photoURL' in data) || data.photoURL is string || data.photoURL == null) &&
             data.createdAt is timestamp;
    }

    // ------------------------------------------------------------------------
    // System Config
    // ------------------------------------------------------------------------
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || ('email' in request.auth.token && isManagerEmail(request.auth.token.email)));
      allow list: if isSignedIn() && 'email' in request.auth.token && isManagerEmail(request.auth.token.email);
      
      allow create: if isValidId(userId) && (request.auth.uid == userId || ('email' in request.auth.token && isManagerEmail(request.auth.token.email))) && 
                    isValidUserProfile(incoming()) &&
                    ('email' in request.auth.token) &&
                    (!('role' in incoming()) || ('email' in request.auth.token && isManagerEmail(request.auth.token.email)) || isAllowedRoleForUser(request.auth.token.email, incoming().role));
                    
      allow update: if isValidId(userId) && (request.auth.uid == userId || ('email' in request.auth.token && isManagerEmail(request.auth.token.email))) && 
                    isValidUserProfile(incoming()) &&
                    (('email' in request.auth.token && isManagerEmail(request.auth.token.email)) || !('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role) &&
                    (!('role' in existing()) || existing().role != 'admin' || request.auth.uid == userId);
                    
      allow delete: if isSignedIn() && (request.auth.uid == userId || ('email' in request.auth.token && isAdminEmail(request.auth.token.email) && existing().role != 'admin'));
    }

    // ------------------------------------------------------------------------
    // Technicians Collection
    // ------------------------------------------------------------------------
    function isValidTechnician(data) {
      return data.size() >= 1 && data.size() <= 40 &&
             data.name is string &&
             (!('employeeId' in data) || data.employeeId is string) &&
             (!('specialty' in data) || data.specialty is string) &&
             (!('idCard' in data) || data.idCard is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('status' in data) || data.status is string) &&
             (!('photoURL' in data) || data.photoURL is string || data.photoURL == null) &&
             (!('role' in data) || data.role is string) &&
             (!('email' in data) || data.email is string) &&
             (!('department' in data) || data.department is string) &&
             (!('uid' in data) || data.uid is string || data.uid == null) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
             (!('isDeleted' in data) || data.isDeleted is bool) &&
             (!('deletedAt' in data) || (data.deletedAt is timestamp || data.deletedAt == null || data.deletedAt is string)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    function isSelfTechnician(techData) {
      return isSignedIn() && 
             (
                ('uid' in techData && techData.uid == request.auth.uid) || 
                ('email' in techData && 'email' in request.auth.token && techData.email.lower() == request.auth.token.email.lower())
             );
    }

    match /technicians/{techId} {
      allow get: if isValidId(techId) && isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isValidId(techId) && isManager() && isValidTechnician(incoming());
      
      allow update: if isValidId(techId) && isValidTechnician(incoming()) &&
                    (
                      isManager() || 
                      (
                        isSelfTechnician(existing()) &&
                        (!('role' in existing()) || !('role' in incoming()) || incoming().role == existing().role) &&
                        (!('employeeId' in existing()) || !('employeeId' in incoming()) || incoming().employeeId == existing().employeeId) &&
                        (!('isDeleted' in existing()) || !('isDeleted' in incoming()) || incoming().isDeleted == existing().isDeleted)
                      )
                    ) &&
                    ( !('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt ) &&
                    (!('role' in existing()) || existing().role != 'admin' || isSelfTechnician(existing()));
                    
      allow delete: if isSignedIn() && (isSelfTechnician(existing()) || (isAdmin() && existing().role != 'admin'));
    }

    // ------------------------------------------------------------------------
    // Activities Collection
    // ------------------------------------------------------------------------
    function isValidActivity(data) {
      return data.size() >= 1 && data.size() <= 60 &&
             data.title is string &&
             (!('description' in data) || data.description == null || data.description is string) &&
             (!('type' in data) || data.type == null || data.type is string) &&
             (!('status' in data) || data.status == null || data.status is string) &&
             (!('rejectionReason' in data) || data.rejectionReason == null || data.rejectionReason is string) &&
             (!('hasPerDiem' in data) || data.hasPerDiem == null || data.hasPerDiem is bool) &&
             (!('date' in data) || data.date == null || data.date is timestamp || data.date is string) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string) &&
             (!('technicianId' in data) || data.technicianId == null || data.technicianId is string) &&
             (!('technicianName' in data) || data.technicianName == null || data.technicianName is string) &&
             (!('participants' in data) || data.participants == null || data.participants is list) &&
             (!('notes' in data) || data.notes == null || data.notes is list) &&
             (!('isDeleted' in data) || data.isDeleted == null || data.isDeleted is bool) &&
             (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp || data.deletedAt is string) &&
             (!('deletedBy' in data) || data.deletedBy == null || data.deletedBy is string) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is string) &&
             (!('adminId' in data) || data.adminId == null || data.adminId is string) &&
             (!('overtimeHours' in data) || data.overtimeHours == null || data.overtimeHours is number) &&
             (!('perDiemAmount' in data) || data.perDiemAmount == null || (data.perDiemAmount is number && data.perDiemAmount >= 0)) &&
             (!('startTime' in data) || data.startTime == null || data.startTime is string) &&
             (!('endTime' in data) || data.endTime == null || data.endTime is string) &&
             (!('startTimeMorning' in data) || data.startTimeMorning == null || data.startTimeMorning is string) &&
             (!('endTimeMorning' in data) || data.endTimeMorning == null || data.endTimeMorning is string) &&
             (!('hasPause' in data) || data.hasPause == null || data.hasPause is string) &&
             (!('startTimeAfternoon' in data) || data.startTimeAfternoon == null || data.startTimeAfternoon is string) &&
             (!('endTimeAfternoon' in data) || data.endTimeAfternoon == null || data.endTimeAfternoon is string) &&
             (!('region' in data) || data.region == null || data.region is string) &&
             (!('totalHours' in data) || data.totalHours == null || data.totalHours is number) &&
             (!('justification' in data) || data.justification == null || data.justification is string) &&
             (!('documentation' in data) || data.documentation == null || data.documentation is string) &&
             (!('driver' in data) || data.driver == null || data.driver is string) &&
             (!('code' in data) || data.code == null || data.code is string) &&
             (!('cause' in data) || data.cause == null || data.cause is string) &&
             (!('fleet' in data) || data.fleet == null || data.fleet is string) &&
             (!('tecnicosIds' in data) || data.tecnicosIds == null || data.tecnicosIds is list) &&
             (!('id' in data) || data.id == null || data.id is string);
    }

    function isParticipating(data) {
      return (data.adminId == request.auth.uid) || 
             (request.auth.token != null && 'name' in request.auth.token && data.participants != null && request.auth.token.name in data.participants);
    }

    match /activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (isAdmin() || hasUserRole('supervisor') || isParticipating(resource.data));
      allow list: if isSignedIn();
      
      allow create: if isValidId(activityId) && isSignedIn() && isValidActivity(incoming()) && (
                      hasUserRole('supervisor') ||
                      ((hasUserRole('tecnico') || hasUserRole('user')) && incoming().adminId == request.auth.uid)
                    );
      
      allow update: if isValidId(activityId) && 
                    isSignedIn() && 
                    isValidActivity(incoming()) &&
                    (
                      isAdmin() ||
                      hasUserRole('supervisor') ||
                      (
                        isParticipating(existing()) && 
                        existing().status != 'aprobado'
                      )
                    ) &&
                    ( !('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt );
                      
      allow delete: if isAdmin() || hasUserRole('supervisor');
    }

    // ------------------------------------------------------------------------
    // Notifications Collection
    // ------------------------------------------------------------------------
    function isValidNotification(data) {
      return data.size() >= 3 && data.size() <= 18 &&
             data.keys().hasAll(['type', 'message', 'createdAt']) &&
             data.type is string && data.type.size() <= 50 &&
             data.message is string && data.message.size() <= 600 &&
             data.createdAt is timestamp &&
             (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 1000)) &&
             (!('userId' in data) || data.userId == null || data.userId is string) &&
             (!('userName' in data) || data.userName == null || data.userName is string) &&
             (!('severity' in data) || data.severity == null || data.severity in ['normal', 'medium', 'high']) &&
             (!('technician' in data) || data.technician == null || data.technician is string) &&
             (!('week' in data) || data.week == null || data.week is string) &&
             (!('date' in data) || data.date == null || data.date is string) &&
             (!('scope' in data) || data.scope in ['global', 'departmental', 'personal']) &&
             (!('targetRole' in data) || data.targetRole in ['admin', 'supervisor', 'tecnico', 'all']) &&
             (!('targetUserId' in data) || data.targetUserId == null || data.targetUserId is string) &&
             (!('relatedId' in data) || data.relatedId == null || data.relatedId is string) &&
             (!('oldValue' in data) || data.oldValue == null || data.oldValue is string) &&
             (!('newValue' in data) || data.newValue == null || data.newValue is string) &&
             (!('userRole' in data) || data.userRole == null || data.userRole is string) &&
             (!('department' in data) || data.department == null || data.department is string);
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn() && (
        isAdmin() ||
        (hasUserRole('supervisor') && (resource.data.scope == 'departmental' || resource.data.targetRole == 'supervisor' || resource.data.scope == 'global')) ||
        (hasUserRole('tecnico') && resource.data.targetUserId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        hasUserRole('supervisor') ||
        (hasUserRole('tecnico') && resource.data.targetUserId == request.auth.uid)
      );
      
      allow create: if isValidId(notifId) && isSignedIn() && isValidNotification(incoming());
      
      allow update: if isValidId(notifId) && isSignedIn() && 
                    (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
                    (!('type' in existing()) || !('type' in incoming()) || incoming().type == existing().type) &&
                    (!('message' in existing()) || !('message' in incoming()) || incoming().message == existing().message) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['readBy']) &&
                    incoming().readBy is list;
                     
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Test Connection Connection
    // ------------------------------------------------------------------------
    match /test/connection {
      allow read: if true;
    }
  }
}
